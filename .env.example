# Copy to .env and edit. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

CHRONOFLUX_HOST=0.0.0.0
CHRONOFLUX_PORT=8000

# --- Console login (admin / analyst) ---
CHRONOFLUX_AUTH=1
# Password for the first 'admin' user (empty = generate one and print it once)
CHRONOFLUX_ADMIN_PASSWORD=
# Set to 1 when served over HTTPS so the session cookie is marked Secure
CHRONOFLUX_SECURE_COOKIES=0

# --- Live sensor ---
# Key every sensor must send (live/sensor.py --api-key, or the same variable on the sensor host)
CHRONOFLUX_SENSOR_KEY=
CHRONOFLUX_SERVER=http://127.0.0.1:8000
CHRONOFLUX_SENSOR_ID=gateway-sensor

# --- Alerts (live HIGH/CRITICAL detections) ---
CHRONOFLUX_ALERT_MIN_SCORE=60
CHRONOFLUX_ALERT_COOLDOWN=600
CHRONOFLUX_PUBLIC_URL=http://127.0.0.1:8000
CHRONOFLUX_SMTP_HOST=
CHRONOFLUX_SMTP_PORT=587
CHRONOFLUX_SMTP_USER=
CHRONOFLUX_SMTP_PASSWORD=
CHRONOFLUX_SMTP_TLS=true
CHRONOFLUX_ALERT_EMAIL_TO=
CHRONOFLUX_TELEGRAM_BOT_TOKEN=
CHRONOFLUX_TELEGRAM_CHAT_ID=
